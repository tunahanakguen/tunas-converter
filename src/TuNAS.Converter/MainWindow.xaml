<Window x:Class="TuNAS.Converter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:TuNAS.Converter.ViewModels"
        xmlns:models="clr-namespace:TuNAS.Converter.Models"
        Title="TUNAS CONVERTER" Icon="Resources/TunasConverter.ico" Width="1040" Height="720" MinWidth="820" MinHeight="560"
        WindowStartupLocation="CenterScreen" Background="{StaticResource WindowBackground}"
        AllowDrop="True" DragOver="OnDragOver" Drop="OnDrop">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Kopfzeile -->
        <Border Grid.Row="0" Background="{StaticResource HeaderBackground}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="16,10">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="42" Height="42" CornerRadius="8" VerticalAlignment="Center">
                        <Border.Background>
                            <ImageBrush ImageSource="{StaticResource LogoImage}" RenderOptions.BitmapScalingMode="HighQuality" />
                        </Border.Background>
                    </Border>
                    <TextBlock FontSize="20" FontWeight="Bold" Margin="12,0,0,0" VerticalAlignment="Center">
                        <Run Text="TUNAS" Foreground="{StaticResource TextPrimary}" /><Run Text=" CONVERTER" FontWeight="Light" Foreground="{StaticResource TextPrimary}" />
                    </TextBlock>
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource FlatButton}" Command="{Binding AddVideosCommand}" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFont}" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="Video" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource FlatButton}" Command="{Binding AddAudioCommand}" Margin="0,0,16,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFont}" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="Audio" />
                        </StackPanel>
                    </Button>
                    <CheckBox IsChecked="{Binding JoinFiles}" VerticalAlignment="Center" Margin="0,0,16,0"
                              ToolTip="Alle Clips nacheinander zu einer einzigen Datei zusammenfügen (Reihenfolge wie in der Liste)">
                        <TextBlock Text="Zusammenfügen" Foreground="{StaticResource TextPrimary}" />
                    </CheckBox>
                    <Button Style="{StaticResource FlatButton}" Command="{Binding ClearAllCommand}" Content="Liste leeren"
                            Visibility="{Binding HasClips, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Dateiliste -->
        <Grid Grid.Row="1" Margin="16,12,16,8">
            <Border Background="{StaticResource PanelBackground}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8">
                <ListBox x:Name="ClipList" ItemsSource="{Binding Clips}" BorderThickness="0" Background="Transparent"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch"
                         VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Focusable" Value="False" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Bd" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Background="Transparent" Padding="12,8">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#1A1A1D" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type models:ClipItem}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Width="96" Height="54" CornerRadius="4" Background="{StaticResource PanelAlt}" ClipToBounds="True">
                                    <Grid>
                                        <TextBlock Text="&#xE714;" FontFamily="{StaticResource IconFont}" FontSize="20" Foreground="{StaticResource TextMuted}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />
                                    </Grid>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding FileName}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding DetailsText}" FontSize="12" Margin="0,3,0,0" TextTrimming="CharacterEllipsis">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasError}" Value="True">
                                                        <Setter Property="Foreground" Value="{StaticResource Danger}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <ProgressBar IsIndeterminate="True" Height="3" Width="160" HorizontalAlignment="Left" Margin="0,6,0,0"
                                                 Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Style="{StaticResource IconButton}" Content="&#xE70E;" ToolTip="Nach oben" Margin="0,0,4,0"
                                            Command="{Binding DataContext.MoveUpCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}" />
                                    <Button Style="{StaticResource IconButton}" Content="&#xE70D;" ToolTip="Nach unten" Margin="0,0,12,0"
                                            Command="{Binding DataContext.MoveDownCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}" />
                                    <Button Style="{StaticResource FlatButton}" ToolTip="Stellen herausschneiden" Margin="0,0,4,0"
                                            IsEnabled="{Binding CanEdit}"
                                            Command="{Binding DataContext.EditClipCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE8C6;" FontFamily="{StaticResource IconFont}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                            <TextBlock Text="Schneiden" />
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource IconButton}" Content="&#xE711;" ToolTip="Aus der Liste entfernen"
                                            Command="{Binding DataContext.RemoveClipCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <!-- Leerer Zustand -->
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"
                        Visibility="{Binding HasClips, Converter={StaticResource InverseBoolToVisibility}}">
                <Border Width="150" Height="150" CornerRadius="22" HorizontalAlignment="Center">
                    <Border.Background>
                        <ImageBrush ImageSource="{StaticResource LogoImage}" RenderOptions.BitmapScalingMode="HighQuality" />
                    </Border.Background>
                </Border>
                <TextBlock Text="Videos oder Audiodateien hierher ziehen" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" Margin="0,16,0,4" HorizontalAlignment="Center" />
                <TextBlock Text="oder oben auf „Video“ bzw. „Audio“ klicken" FontSize="13" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center" />
            </StackPanel>
        </Grid>

        <!-- Einstellungen nach Klick auf ein Format -->
        <Border Grid.Row="2" Margin="16,0,16,8" Padding="16,12" Background="{StaticResource PanelBackground}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8"
                Visibility="{Binding IsSettingsVisible, Converter={StaticResource BoolToVisibility}}">
            <StackPanel>
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE711;" ToolTip="Schließen"
                            Command="{Binding CloseSettingsCommand}" IsEnabled="{Binding IsConverting, Converter={StaticResource InverseBool}}" />
                    <TextBlock Text="{Binding SettingsTitle}" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center" />
                </DockPanel>

                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <TextBlock Text="Qualität:" Width="80" VerticalAlignment="Center" Foreground="{StaticResource TextSecondary}" />
                    <RadioButton Style="{StaticResource FlatButton}" GroupName="Quality" Margin="0,0,6,0"
                                 IsChecked="{Binding Quality, Converter={StaticResource EnumEquals}, ConverterParameter=Original}"
                                 ToolTip="Verlustfrei umpacken, wenn möglich – sonst höchste Qualität">
                        <TextBlock Text="Original" />
                    </RadioButton>
                    <RadioButton Style="{StaticResource FlatButton}" GroupName="Quality" Margin="0,0,6,0"
                                 IsChecked="{Binding Quality, Converter={StaticResource EnumEquals}, ConverterParameter=Hoch}" Content="Hoch" />
                    <RadioButton Style="{StaticResource FlatButton}" GroupName="Quality" Margin="0,0,6,0"
                                 IsChecked="{Binding Quality, Converter={StaticResource EnumEquals}, ConverterParameter=Mittel}" Content="Mittel" />
                    <RadioButton Style="{StaticResource FlatButton}" GroupName="Quality"
                                 IsChecked="{Binding Quality, Converter={StaticResource EnumEquals}, ConverterParameter=Klein}" Content="Klein" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <TextBlock Text="Ergebnis:" Width="80" VerticalAlignment="Center" Foreground="{StaticResource TextSecondary}" />
                    <Ellipse Width="12" Height="12" VerticalAlignment="Center" Margin="0,0,8,0">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="Transparent" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Verdict}" Value="{x:Static vm:Verdict.Lossless}">
                                        <Setter Property="Fill" Value="{StaticResource Green}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Verdict}" Value="{x:Static vm:Verdict.NearlySame}">
                                        <Setter Property="Fill" Value="{StaticResource Yellow}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Verdict}" Value="{x:Static vm:Verdict.Visible}">
                                        <Setter Property="Fill" Value="{StaticResource Orange}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="{Binding VerdictText}" VerticalAlignment="Center" Foreground="{StaticResource TextPrimary}" Margin="0,0,16,0" />
                    <TextBlock Text="{Binding EstimateText}" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" />
                </StackPanel>
                <TextBlock Text="{Binding HintText}" Margin="80,6,0,0" TextWrapping="Wrap" Foreground="{StaticResource Orange}"
                           Visibility="{Binding HintText, Converter={StaticResource NullToVisibility}}" />

                <DockPanel Margin="0,12,0,0" Visibility="{Binding IsOutputNameEditable, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="Dateiname:" Width="80" VerticalAlignment="Center" Foreground="{StaticResource TextSecondary}" />
                    <TextBlock DockPanel.Dock="Right" Text="{Binding OutputExtension}" Width="60" Margin="8,0,0,0" VerticalAlignment="Center"
                               Foreground="{StaticResource TextSecondary}" />
                    <TextBox Text="{Binding OutputName, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center" Padding="6,4" MaxLength="35"
                             IsEnabled="{Binding IsConverting, Converter={StaticResource InverseBool}}"
                             ToolTip="Name der fertigen Datei. Gibt es den Namen schon, wird „(2)“ angehängt – nichts wird überschrieben." />
                </DockPanel>
                <TextBlock Margin="80,12,0,0" Foreground="{StaticResource TextSecondary}"
                           Text="Mehrere Dateien: Jede behält ihren Originalnamen, nur die Endung ändert sich."
                           Visibility="{Binding IsOutputNameEditable, Converter={StaticResource InverseBoolToVisibility}}" />

                <DockPanel Margin="0,12,0,0">
                    <TextBlock Text="Zielordner:" Width="80" VerticalAlignment="Center" Foreground="{StaticResource TextSecondary}" />
                    <Grid DockPanel.Dock="Right" Margin="12,0,0,0">
                        <Button Style="{StaticResource PrimaryButton}" Command="{Binding ConvertCommand}" IsEnabled="{Binding CanConvert}"
                                Visibility="{Binding IsConverting, Converter={StaticResource InverseBoolToVisibility}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE768;" FontFamily="{StaticResource IconFont}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock Text="Umwandeln" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource FlatButton}" Command="{Binding CancelCommand}" Content="Abbrechen"
                                Visibility="{Binding IsConverting, Converter={StaticResource BoolToVisibility}}" />
                    </Grid>
                    <Button DockPanel.Dock="Right" Style="{StaticResource FlatButton}" Command="{Binding OpenOutputFolderCommand}" Content="Öffnen" Margin="6,0,0,0" />
                    <Button DockPanel.Dock="Right" Style="{StaticResource FlatButton}" Command="{Binding BrowseOutputFolderCommand}" Content="Ändern …" Margin="6,0,0,0"
                            IsEnabled="{Binding IsConverting, Converter={StaticResource InverseBool}}" />
                    <TextBox Text="{Binding OutputFolder, Mode=OneWay}" IsReadOnly="True" VerticalContentAlignment="Center" Padding="6,4"
                             BorderBrush="{StaticResource BorderBrush}" Foreground="{StaticResource TextPrimary}" />
                </DockPanel>

                <StackPanel Margin="0,12,0,0" Visibility="{Binding IsConverting, Converter={StaticResource BoolToVisibility}}">
                    <ProgressBar Height="8" Minimum="0" Maximum="100" Value="{Binding Progress}" Foreground="{StaticResource Accent}" />
                    <TextBlock Text="{Binding ProgressText}" Margin="0,6,0,0" Foreground="{StaticResource TextSecondary}" TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <TextBlock Text="{Binding ResultText}" Margin="0,12,0,0" TextWrapping="Wrap"
                           Visibility="{Binding ResultText, Converter={StaticResource NullToVisibility}}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{StaticResource Green}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ResultIsError}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource Danger}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </Border>

        <!-- Formatknöpfe -->
        <Border Grid.Row="3" Background="{StaticResource PanelBackground}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="16,12">
            <StackPanel Orientation="Horizontal">
                <ItemsControl ItemsSource="{Binding MainFormats}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type models:OutputFormat}">
                            <ToggleButton Style="{StaticResource FormatButton}" ToolTip="{Binding Description}"
                                          Command="{Binding DataContext.SelectFormatCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                          CommandParameter="{Binding}"
                                          IsEnabled="{Binding DataContext.IsConverting, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource InverseBool}}">
                                <ToggleButton.IsChecked>
                                    <MultiBinding Converter="{StaticResource ReferenceEquals}" Mode="OneWay">
                                        <Binding />
                                        <Binding Path="DataContext.SelectedFormat" RelativeSource="{RelativeSource AncestorType=Window}" />
                                    </MultiBinding>
                                </ToggleButton.IsChecked>
                                <StackPanel>
                                    <TextBlock Text="{Binding Icon}" FontFamily="{StaticResource IconFont}" FontSize="22" HorizontalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource Accent}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding AudioOnly}" Value="True">
                                                        <Setter Property="Foreground" Value="{StaticResource AudioAccent}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" Margin="0,6,0,0" HorizontalAlignment="Center" />
                                </StackPanel>
                            </ToggleButton>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button x:Name="MoreButton" Style="{StaticResource FormatButton}" Click="OnMoreClick" ToolTip="Weitere Formate: FLV, MPEG, 3GP, M4A, WAV, FLAC, OGG, Opus, WMA, AC3, AMR">
                    <Button.ContextMenu>
                        <ContextMenu ItemsSource="{Binding MoreFormats}">
                            <ContextMenu.ItemContainerStyle>
                                <Style TargetType="MenuItem">
                                    <Setter Property="Header" Value="{Binding Name}" />
                                    <Setter Property="ToolTip" Value="{Binding Description}" />
                                    <Setter Property="Command" Value="{Binding DataContext.SelectFormatCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                    <Setter Property="CommandParameter" Value="{Binding}" />
                                </Style>
                            </ContextMenu.ItemContainerStyle>
                        </ContextMenu>
                    </Button.ContextMenu>
                    <StackPanel>
                        <TextBlock Text="&#xE712;" FontFamily="{StaticResource IconFont}" FontSize="22" HorizontalAlignment="Center" Foreground="{StaticResource Accent}" />
                        <TextBlock Text="Mehr" FontSize="13" FontWeight="SemiBold" Margin="0,6,0,0" HorizontalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</Window>
