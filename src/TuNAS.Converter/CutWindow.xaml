<Window x:Class="TuNAS.Converter.CutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
        Title="Schneiden" Icon="Resources/TunasConverter.ico" Width="1000" Height="700" MinWidth="760" MinHeight="520"
        WindowStartupLocation="CenterOwner" Background="{StaticResource WindowBackground}"
        PreviewKeyDown="OnPreviewKeyDown">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Player -->
        <Border Grid.Row="0" Background="Black">
            <vlc:VideoView x:Name="Video" />
        </Border>

        <!-- Zeitleiste: rot = wird entfernt, blau = aktuelle Auswahl -->
        <Grid Grid.Row="1" Margin="16,12,16,0">
            <Canvas x:Name="Ranges" Height="20" VerticalAlignment="Center" ClipToBounds="True" Background="{StaticResource TimelineBackground}" SizeChanged="OnRangesSizeChanged" />
            <Slider x:Name="Position" Minimum="0" VerticalAlignment="Center" IsMoveToPointEnabled="True"
                    ValueChanged="OnPositionChanged" Thumb.DragStarted="OnDragStarted" Thumb.DragCompleted="OnDragCompleted" />
        </Grid>

        <!-- Bedienleiste -->
        <DockPanel Grid.Row="2" Margin="16,10,16,0" LastChildFill="False">
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                <Button Style="{StaticResource IconButton}" Content="&#xE892;" ToolTip="Ein Bild zurück (Pfeil links)" Click="OnStepBack" Margin="0,0,4,0" />
                <Button x:Name="PlayButton" Style="{StaticResource IconButton}" Content="&#xE768;" ToolTip="Abspielen / Pause (Leertaste)" Click="OnPlayPause" Margin="0,0,4,0" />
                <Button Style="{StaticResource IconButton}" Content="&#xE893;" ToolTip="Ein Bild vor (Pfeil rechts)" Click="OnStepForward" Margin="0,0,10,0" />
                <TextBlock x:Name="TimeText" VerticalAlignment="Center" FontFamily="Consolas" FontSize="13" Foreground="{StaticResource TextPrimary}" Text="00:00.0 / 00:00.0" />
                <!-- Lautstärke -->
                <Button x:Name="MuteButton" Style="{StaticResource IconButton}" Content="&#xE767;" ToolTip="Stumm / Laut (Taste M)" Click="OnMuteClick" Margin="16,0,4,0" />
                <Slider x:Name="VolumeSlider" Width="110" Minimum="0" Maximum="100" SmallChange="5" LargeChange="10" VerticalAlignment="Center"
                        IsMoveToPointEnabled="True" ValueChanged="OnVolumeChanged" ToolTip="Lautstärke (Pfeil hoch / runter)" />
                <TextBlock x:Name="VolumeText" Width="40" Margin="6,0,0,0" VerticalAlignment="Center" FontSize="12"
                           Foreground="{StaticResource TextSecondary}" Text="80 %" />
            </StackPanel>

            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Style="{StaticResource FlatButton}" Click="OnMarkStart" ToolTip="Anfang der Stelle markieren (Taste I)" Margin="0,0,4,0">
                    <TextBlock Text="[  Anfang" />
                </Button>
                <Button Style="{StaticResource FlatButton}" Click="OnMarkEnd" ToolTip="Ende der Stelle markieren (Taste O)" Margin="0,0,8,0">
                    <TextBlock Text="Ende  ]" />
                </Button>
                <Button x:Name="CutButton" Style="{StaticResource FlatButton}" Click="OnCut" ToolTip="Markierte Stelle herausschneiden (Entf)" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8C6;" FontFamily="{StaticResource IconFont}" Margin="0,0,6,0" VerticalAlignment="Center" />
                        <TextBlock Text="Herausschneiden" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource IconButton}" Content="&#xE7A7;" ToolTip="Rückgängig (Strg+Z)" Click="OnUndo" Margin="0,0,4,0" />
                <Button Style="{StaticResource FlatButton}" Content="Alle Schnitte löschen" Click="OnResetAll" />
            </StackPanel>
        </DockPanel>

        <!-- Zusammenfassung und OK -->
        <DockPanel Grid.Row="3" Margin="16,12,16,16">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Bottom">
                <Button Style="{StaticResource FlatButton}" Content="Abbrechen" IsCancel="True" Margin="0,0,8,0" />
                <Button Style="{StaticResource PrimaryButton}" Content="Übernehmen" Click="OnOk" />
            </StackPanel>
            <StackPanel>
                <TextBlock x:Name="SelectionText" Foreground="{StaticResource TextSecondary}" Text="Anfang und Ende markieren, dann „Herausschneiden“ klicken." />
                <TextBlock x:Name="SummaryText" Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold" Margin="0,4,0,0" TextWrapping="Wrap" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
