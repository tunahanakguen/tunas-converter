<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <PlatformTarget>x64</PlatformTarget>
    <RootNamespace>TuNAS.Converter</RootNamespace>
    <AssemblyName>TuNASConverter</AssemblyName>
    <Product>TuNAS Converter</Product>
    <Title>TuNAS Converter</Title>
    <Authors>Tunahan A.</Authors>
    <Copyright>Copyright © 2026 Tunahan A. – GPL-3.0</Copyright>
    <Version>0.2.1</Version>
    <ApplicationIcon>Resources\TunasConverter.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Resources\TunasConverter.ico" />
    <Resource Include="Resources\TunasLogo.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="LibVLCSharp.WPF" Version="3.10.2" />
    <PackageReference Include="VideoLAN.LibVLC.Windows" Version="3.0.24" />
  </ItemGroup>

</Project>
